# Solo valores de demostración; no usar credenciales reales.
APP_ENV=local
APP_TIMEZONE=America/Merida
DEMO_OWNER_ID=efren
WORKER_POLL_INTERVAL_SECONDS=1.0

POSTGRES_DB=efren_bot
POSTGRES_USER=efren_bot
POSTGRES_PASSWORD=local_demo_only
# Host. Compose usa el mismo nombre DATABASE_URL con host db:5432.
DATABASE_URL=postgresql+psycopg://efren_bot:local_demo_only@127.0.0.1:55432/efren_bot
# Solo Make/pruebas; la aplicación sigue leyendo únicamente DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://efren_bot:local_demo_only@127.0.0.1:55433/efren_bot_test

# Host. Compose lo sustituye por http://api:8000 para Vite dentro del contenedor.
VITE_PROXY_TARGET=http://127.0.0.1:8000
